{%- style -%}
  .aangan-newsletter {
    background-color: #252017;
    padding: 6rem 0;
    border-top: 1px solid rgba(245, 240, 232, 0.08);
    border-bottom: 1px solid rgba(245, 240, 232, 0.08);
  }

  .aangan-newsletter__container {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 2rem;
    text-align: center;
  }

  .aangan-newsletter__eyebrow {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #C4A57B;
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .aangan-newsletter__heading {
    font-family: 'Clash Display', sans-serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 600;
    color: #F5F0E8;
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }

  .aangan-newsletter__text {
    font-family: 'Satoshi', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: #A8A095;
    margin: 0 0 2.5rem 0;
  }

  .aangan-newsletter__form {
    display: flex;
    gap: 0;
    max-width: 500px;
    margin: 0 auto;
  }

  .aangan-newsletter__input {
    flex-grow: 1;
    background-color: #1A1614;
    border: 1px solid rgba(245, 240, 232, 0.15);
    color: #F5F0E8;
    font-family: 'Satoshi', sans-serif;
    font-size: 0.95rem;
    padding: 1rem 1.25rem;
    outline: none;
    transition: border-color 0.3s ease;
  }

  .aangan-newsletter__input::placeholder {
    color: #6A6560;
  }

  .aangan-newsletter__input:focus {
    border-color: #C4A57B;
  }

  .aangan-newsletter__input:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .aangan-newsletter__button {
    background-color: #C4A57B;
    color: #1A1614;
    font-family: 'Satoshi', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 1rem 2rem;
    border: 1px solid #C4A57B;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .aangan-newsletter__button:hover:not(:disabled) {
    background-color: transparent;
    color: #C4A57B;
  }

  .aangan-newsletter__button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Success message */
  .aangan-newsletter__success {
    font-family: 'Satoshi', sans-serif;
    font-size: 1rem;
    color: #C4A57B;
    margin: 1.5rem 0 0 0;
    padding: 1rem 1.5rem;
    text-align: center;
    line-height: 1.6;
    font-weight: 500;
    background-color: rgba(196, 165, 123, 0.1);
    border: 1px solid rgba(196, 165, 123, 0.3);
    border-radius: 0;
    animation: aanganFadeIn 0.4s ease;
  }

  /* Error message */
  .aangan-newsletter__error {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.9rem;
    color: #D88A8A;
    margin: 1.5rem 0 0 0;
    padding: 1rem 1.5rem;
    text-align: center;
    background-color: rgba(216, 138, 138, 0.1);
    border: 1px solid rgba(216, 138, 138, 0.3);
    animation: aanganFadeIn 0.4s ease;
  }

  /* Loading state */
  .aangan-newsletter__loading {
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(26, 22, 20, 0.3);
    border-top-color: #1A1614;
    border-radius: 50%;
    animation: aanganSpin 0.6s linear infinite;
    margin-right: 0.5rem;
    vertical-align: middle;
  }

  @keyframes aanganFadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes aanganSpin {
    to { transform: rotate(360deg); }
  }

  @media screen and (max-width: 550px) {
    .aangan-newsletter__form { 
      flex-direction: column; 
      gap: 0.75rem;
    }
    .aangan-newsletter__button { 
      width: 100%; 
      padding: 1rem 1.5rem;
    }
    .aangan-newsletter { padding: 4rem 0; }
    .aangan-newsletter__container { padding: 0 1.5rem; }
  }
{%- endstyle -%}

<section class="aangan-newsletter" id="AanganNewsletter">
  <div class="aangan-newsletter__container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="aangan-newsletter__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h2 class="aangan-newsletter__heading">{{ section.settings.heading }}</h2>
    <p class="aangan-newsletter__text">{{ section.settings.text }}</p>

    <form 
      id="AanganNewsletterForm" 
      class="aangan-newsletter__form" 
      method="post" 
      action="/contact#AanganNewsletter"
      novalidate
    >
      <input type="hidden" name="form_type" value="customer">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="hidden" name="contact[accepts_marketing]" value="true">

      <input
        type="email"
        name="contact[email]"
        id="AanganNewsletterEmail"
        class="aangan-newsletter__input"
        placeholder="Your email address"
        required
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
      >
      <button type="submit" id="AanganNewsletterButton" class="aangan-newsletter__button">
        <span class="aangan-newsletter__button-text">{{ section.settings.button_text }}</span>
      </button>
    </form>

    <div id="AanganNewsletterMessage" role="status" aria-live="polite"></div>
  </div>
</section>

<script>
  (function() {
    const form = document.getElementById('AanganNewsletterForm');
    const emailInput = document.getElementById('AanganNewsletterEmail');
    const button = document.getElementById('AanganNewsletterButton');
    const buttonText = button.querySelector('.aangan-newsletter__button-text');
    const messageDiv = document.getElementById('AanganNewsletterMessage');

    if (!form) return;

    form.addEventListener('submit', function(e) {
      e.preventDefault();

      const email = emailInput.value.trim();
      if (!email) {
        showMessage('Please enter your email address.', 'error');
        return;
      }

      // Email validation
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        showMessage('Please enter a valid email address.', 'error');
        return;
      }

      // Loading state
      button.disabled = true;
      emailInput.disabled = true;
      buttonText.innerHTML = '<span class="aangan-newsletter__loading"></span>Subscribing...';
      messageDiv.innerHTML = '';

      // Submit via fetch to Shopify contact form
      const formData = new FormData();
      formData.append('form_type', 'customer');
      formData.append('utf8', '✓');
      formData.append('contact[email]', email);
      formData.append('contact[tags]', 'newsletter');
      formData.append('contact[accepts_marketing]', 'true');

      fetch('/contact', {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'text/html'
        }
      })
      .then(function(response) {
        return response.text();
      })
      .then(function(html) {
        // Check if success (Shopify returns 200 with success page)
        // Since we can't reliably parse, assume success if no error
        showMessage('Thank you for joining the Aangan family. Welcome!', 'success');
        form.reset();
      })
      .catch(function(error) {
        console.error('Newsletter error:', error);
        showMessage('Something went wrong. Please try again.', 'error');
      })
      .finally(function() {
        // Reset state
        button.disabled = false;
        emailInput.disabled = false;
        buttonText.textContent = '{{ section.settings.button_text }}';
      });
    });

    function showMessage(text, type) {
      const className = type === 'success' 
        ? 'aangan-newsletter__success' 
        : 'aangan-newsletter__error';
      messageDiv.innerHTML = '<p class="' + className + '">' + text + '</p>';
    }
  })();
</script>

{% schema %}
{
  "name": "Aangan Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Stay Connected"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Aangan Family"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Description",
      "default": "Be the first to know about new collections, exclusive offers, and design inspiration."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Aangan Newsletter"
    }
  ]
}
{% endschema %}