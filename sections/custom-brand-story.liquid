{%- style -%}
  .aangan-story {
    background-color: #1A1614;
    padding: 7rem 0;
  }

  .aangan-story__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .aangan-story__content {
    max-width: 500px;
  }

  .aangan-story__eyebrow {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #C4A57B;
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .aangan-story__heading {
    font-family: 'Clash Display', sans-serif;
    font-size: clamp(2rem, 3.5vw, 3rem);
    line-height: 1.1;
    font-weight: 600;
    color: #F5F0E8;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.02em;
  }

  .aangan-story__text {
    font-family: 'Satoshi', sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: #A8A095;
    margin: 0 0 2rem 0;
  }

  .aangan-story__link {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #C4A57B;
    text-decoration: none;
    border-bottom: 1px solid #C4A57B;
    padding-bottom: 0.25rem;
    transition: all 0.3s ease;
  }

  .aangan-story__link:hover {
    color: #F5F0E8;
    border-color: #F5F0E8;
  }

  .aangan-story__image-wrap {
    aspect-ratio: 4/5;
    overflow: hidden;
    background-color: #252017;
  }

  .aangan-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 990px) {
    .aangan-story__container {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding: 0 2rem;
    }
    .aangan-story { padding: 5rem 0; }
    .aangan-story__content { max-width: 100%; }
  }

  @media screen and (max-width: 550px) {
    .aangan-story__container { padding: 0 1.5rem; }
  }
{%- endstyle -%}

<section class="aangan-story">
  <div class="aangan-story__container">
    <div class="aangan-story__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="aangan-story__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="aangan-story__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="aangan-story__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.link_text != blank -%}
        <a href="{{ section.settings.link_url }}" class="aangan-story__link">
          {{ section.settings.link_text }}
        </a>
      {%- endif -%}
    </div>

    <div class="aangan-story__image-wrap">
      {%- if section.settings.image != blank -%}
        {%- assign story_img_url = section.settings.image | image_url: width: 1200 -%}
        <img 
          src="{{ story_img_url }}" 
          alt="{{ section.settings.image.alt | escape }}"
          class="aangan-story__image"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aangan Brand Story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted in Pakistan, Made for Your Home"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Every piece at Aangan is thoughtfully designed and handcrafted by skilled artisans. We believe in timeless design, sustainable materials, and furniture that brings people together.</p>"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story Image"
    }
  ],
  "presets": [
    {
      "name": "Aangan Brand Story"
    }
  ]
}
{% endschema %}